{
  "rules": {
    ".read": "auth != null",
    "plaetze": { "$w": { "$s": {
      ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
      ".validate": "$s === '0' || ($s === '1' && $w !== 'Leitstelle Ems-Vechte')"
    } } },
    "spieler": { "$u": { ".write": "auth != null && auth.uid === $u" } },
    "status": { "$v": { ".write": "auth != null", ".validate": "newData.isNumber()" } },
    "einsaetze": { "$e": {
      ".write": "auth != null && root.child('plaetze/Leitstelle Ems-Vechte/0').val() === auth.uid",
      "rueck": { "$r": { ".write": "auth != null" } }
    } }
  }
}
